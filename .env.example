# ============================================================
# .env.example — Plantilla de variables de entorno
# Copia este archivo como ".env" y completa tus valores reales:
#   cp .env.example .env
# ¡NUNCA subas el archivo .env real a Git!
# ============================================================

# --- Base de Datos MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finanzas_personales

# --- Seguridad y Tokens JWT ---
# Generar una clave secreta segura con: openssl rand -hex 32
SECRET_KEY=9f8e7d6c5b4a39281726354859607182a1b2c3d4e5f60718293a4b5c6d7e8f90
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Configuración del Servidor FastAPI ---
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Orígenes CORS permitidos (separados por coma) ---
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:5500,http://127.0.0.1:8000,null
